#!/usr/bin/env bash
# ═══════════════════════════════════════════════════
#  CIOS — Openbox autostart
#  Executado automaticamente quando Openbox inicia
#  Shows splash → starts CIOS → splash closes
#
#  Optimized: splash starts BEFORE heavy Python imports,
#  progress updates shown in real-time via file protocol.
# ═══════════════════════════════════════════════════

# Set dark background immediately (prevents flash)
xsetroot -solid '#0a0a0f' 2>/dev/null || true

# Disable accessibility bridge (removes startup delay)
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export PYTHONPATH="/usr/share/cios:${PYTHONPATH:-}"

# Find Python
VENV="/usr/share/cios/.venv/bin/python3"
if [ ! -x "$VENV" ]; then
    VENV="python3"
elif ! $VENV -c "import tkinter" 2>/dev/null; then
    VENV="python3"
fi

# Show splash immediately (before heavy Python imports)
$VENV -m cios.ui.splash &
SPLASH_PID=$!

# Start CIOS
$VENV -m cios.main &

# Safety: kill splash after 10s if app didn't signal
(sleep 10 && kill $SPLASH_PID 2>/dev/null) &
