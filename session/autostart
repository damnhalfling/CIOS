#!/usr/bin/env bash
# ═══════════════════════════════════════════════════
#  Harmoni — Openbox autostart
#  Executado automaticamente quando Openbox inicia
#  Shows splash → starts Harmoni → splash closes
#
#  Optimized: splash starts BEFORE heavy Python imports,
#  progress updates shown in real-time via file protocol.
# ═══════════════════════════════════════════════════

# Set dark background immediately (prevents flash)
xsetroot -solid '#0a0a0f' 2>/dev/null || true

# Disable accessibility bridge (removes startup delay)
export NO_AT_BRIDGE=1
export GTK_A11Y=none

# Find Python
VENV="/usr/share/harmoni/.venv/bin/python3"
if [ ! -x "$VENV" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PROJECT_DIR="$(dirname "$(dirname "${SCRIPT_DIR}")")"
    if [ -x "${PROJECT_DIR}/.venv/bin/python3" ]; then
        VENV="${PROJECT_DIR}/.venv/bin/python3"
    elif [ -x "${HOME}/.local/bin/python3" ]; then
        VENV="${HOME}/.local/bin/python3"
    else
        VENV="python3"
    fi
fi

# Show splash immediately (before heavy Python imports)
$VENV -m harmoni.splash &
SPLASH_PID=$!

# Start Harmoni (it will signal splash to close when ready)
if [ -x "${HOME}/.local/bin/harmoni" ]; then
    "${HOME}/.local/bin/harmoni" &
elif command -v harmoni &>/dev/null; then
    harmoni &
else
    $VENV -m harmoni.main &
fi

# Safety: kill splash after 10s if app didn't signal
(sleep 10 && kill $SPLASH_PID 2>/dev/null) &
