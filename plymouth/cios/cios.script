// CIOS — Plymouth boot script
// Minimal: logo centered on dark background with subtle pulse

// Background
Window.SetBackgroundTopColor(0.04, 0.04, 0.06);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04);

// Logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

// Progress dots
progress = 0;
fun refresh_callback() {
    progress++;
    // Subtle breathing effect on logo
    opacity = Math.Abs(Math.Sin(progress * 0.03)) * 0.3 + 0.7;
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);

// Hide messages and password prompts styling
fun message_callback(text) {
    // Suppress boot messages — keep screen clean
}

Plymouth.SetMessageFunction(message_callback);

// Password prompt (for encrypted disks)
fun display_password_callback(prompt, bullets) {
    // Minimal password prompt if needed
    pass_label.image = Image.Text(prompt, 0.9, 0.9, 0.9);
    pass_label.sprite = Sprite(pass_label.image);
    pass_label.sprite.SetX(Window.GetWidth() / 2 - pass_label.image.GetWidth() / 2);
    pass_label.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 40);

    bullet_string = "";
    for (i = 0; i < bullets; i++) {
        bullet_string += "● ";
    }
    if (bullets > 0) {
        bullets_label.image = Image.Text(bullet_string, 0.49, 0.23, 0.93);
        bullets_label.sprite = Sprite(bullets_label.image);
        bullets_label.sprite.SetX(Window.GetWidth() / 2 - bullets_label.image.GetWidth() / 2);
        bullets_label.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 70);
    }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

// Quit callback — fade out smoothly for seamless transition to LightDM
fun quit_callback() {
    // Instant hide — Plymouth handles the transition
    // The dark background matches LightDM theme, so no flash
    logo.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);

// Boot progress callback — keep splash alive during entire boot
fun boot_progress_callback(duration, progress_val) {
    // Use progress to make breathing slightly faster near end
    speed = 0.03 + (progress_val * 0.02);
    opacity = Math.Abs(Math.Sin(progress * speed)) * 0.3 + 0.7;
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
