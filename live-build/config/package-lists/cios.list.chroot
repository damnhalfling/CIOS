# CIOS Live ISO — Package List
# Packages installed in the live filesystem (chroot)
# Stack: Wayland (cios-shell + greetd + GTK4)

# ── Wayland / Display ─────────────────────────────────────────────
greetd
seatd
xwayland

# ── GTK4 + Python bindings ─────────────────────────────────────────
gir1.2-gtk-4.0
python3-gi
python3-gi-cairo
libgtk-4-1

# ── CIOS Dependencies ──────────────────────────────────────────────
python3
python3-pip
python3-venv
curl
wl-clipboard

# ── Audio ──────────────────────────────────────────────────────────
pipewire
wireplumber
pipewire-pulse

# ── Network ────────────────────────────────────────────────────────
network-manager
wpasupplicant

# ── Boot (seamless: GRUB invisible → Plymouth → greeter) ──────────
plymouth
plymouth-themes
grub-efi-amd64

# ── Firmware ───────────────────────────────────────────────────────
firmware-linux-free
firmware-linux-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros

# ── Utilities ──────────────────────────────────────────────────────
