#!/bin/bash
# ═══════════════════════════════════════════════════
#  Hook: Cleanup to reduce ISO size
#  Removes caches, docs, and unnecessary files.
# ═══════════════════════════════════════════════════
set -euo pipefail

echo ">>> [0450] Cleaning up to reduce ISO size..."

# Remove apt caches
apt-get clean
rm -rf /var/lib/apt/lists/*

# Remove docs and man pages (saves ~200MB)
rm -rf /usr/share/doc/*
rm -rf /usr/share/man/*
rm -rf /usr/share/info/*

# Remove non-English locales
find /usr/share/locale -mindepth 1 -maxdepth 1 \
    ! -name 'en' ! -name 'en_US' ! -name 'locale.alias' \
    -exec rm -rf {} + 2>/dev/null || true

# Remove Python caches
find / -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
find / -type f -name '*.pyc' -delete 2>/dev/null || true

# Remove unnecessary kernel modules (keep essential ones)
# Keep: drm, gpu, net/wireless, usb, input, sound, fs
KVER=$(ls /lib/modules/ | head -1)
if [ -n "$KVER" ] && [ -d "/lib/modules/$KVER/kernel" ]; then
    # Remove staging drivers (huge, rarely needed for live)
    rm -rf "/lib/modules/$KVER/kernel/drivers/staging" 2>/dev/null || true
    # Remove IB/infiniband
    rm -rf "/lib/modules/$KVER/kernel/drivers/infiniband" 2>/dev/null || true
    # Remove media (TV tuners, etc)
    rm -rf "/lib/modules/$KVER/kernel/drivers/media" 2>/dev/null || true
    # Rebuild module deps
    depmod "$KVER" 2>/dev/null || true
fi

# Remove tmp files
rm -rf /tmp/*

echo ">>> [0450] Cleanup complete."
