#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
#  CIOS — AI Setup (Hardware-Aware Model Selection)
#
#  Detects hardware capabilities and selects the optimal LLM model:
#    - Low-end  (≤4 cores, ≤4GB RAM, old CPU): qwen2:1.5b  (~1GB, fast)
#    - Mid-range (≤8 cores, ≤8GB RAM):         qwen2:7b    (~4GB, balanced)
#    - High-end  (>8 cores, >16GB RAM, GPU):   mistral     (~4.5GB, best quality)
#
#  Usage:
#    sudo cios-setup-ai              # Auto-detect and install
#    sudo cios-setup-ai --force-low  # Force lightweight model
#    sudo cios-setup-ai --force-mid  # Force mid-range model
#    sudo cios-setup-ai --force-high # Force high-end model
#    sudo cios-setup-ai --status     # Show current AI status
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

# ── Colors ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[CIOS-AI]${NC} $1"; }
ok()    { echo -e "${GREEN}[CIOS-AI] ✓${NC} $1"; }
warn()  { echo -e "${YELLOW}[CIOS-AI] ⚠${NC} $1"; }
fail()  { echo -e "${RED}[CIOS-AI] ✗${NC} $1"; }

# ═══════════════════════════════════════════════════════════════════════════
#  HARDWARE DETECTION
# ═══════════════════════════════════════════════════════════════════════════

detect_hardware() {
    # CPU cores (physical)
    CPU_CORES=$(nproc 2>/dev/null || echo 2)

    # Total RAM in MB
    RAM_MB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 4096)

    # CPU model and generation (heuristic)
    CPU_MODEL=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs)
    CPU_MHZ=$(awk '/cpu MHz/ {printf "%d", $4; exit}' /proc/cpuinfo 2>/dev/null || echo 0)
    CPU_BOGOMIPS=$(awk '/bogomips/ {printf "%d", $3; exit}' /proc/cpuinfo 2>/dev/null || echo 0)

    # Detect GPU (NVIDIA/AMD discrete)
    HAS_NVIDIA_GPU=0
    HAS_AMD_GPU=0
    if command -v lspci &>/dev/null; then
        lspci 2>/dev/null | grep -qi "NVIDIA.*\(GeForce\|RTX\|GTX\|Tesla\|Quadro\)" && HAS_NVIDIA_GPU=1
        lspci 2>/dev/null | grep -qi "AMD.*\(Radeon RX\|Radeon Pro\|Instinct\)" && HAS_AMD_GPU=1
    fi

    # Check if NVIDIA CUDA is available for Ollama
    HAS_CUDA=0
    if [ $HAS_NVIDIA_GPU -eq 1 ] && command -v nvidia-smi &>/dev/null; then
        nvidia-smi &>/dev/null && HAS_CUDA=1
    fi

    # Available disk space in GB
    DISK_FREE_GB=$(df -BG / 2>/dev/null | awk 'NR==2 {gsub("G",""); print $4}' || echo 10)

    # CPU performance score (rough heuristic)
    # Based on: cores × bogomips (normalized)
    if [ $CPU_BOGOMIPS -gt 0 ]; then
        CPU_SCORE=$(( CPU_CORES * CPU_BOGOMIPS / 1000 ))
    else
        CPU_SCORE=$(( CPU_CORES * 3 ))  # fallback estimate
    fi
}

print_hardware() {
    echo ""
    echo "  ┌─────────────────────────────────────────┐"
    echo "  │  Hardware Detected                      │"
    echo "  ├─────────────────────────────────────────┤"
    printf "  │  CPU:    %-31s│\n" "${CPU_MODEL:0:31}"
    printf "  │  Cores:  %-31s│\n" "$CPU_CORES"
    printf "  │  RAM:    %-31s│\n" "${RAM_MB}MB"
    printf "  │  Disk:   %-31s│\n" "${DISK_FREE_GB}GB free"
    if [ $HAS_NVIDIA_GPU -eq 1 ]; then
        printf "  │  GPU:    %-31s│\n" "NVIDIA (CUDA: $([ $HAS_CUDA -eq 1 ] && echo 'yes' || echo 'no'))"
    elif [ $HAS_AMD_GPU -eq 1 ]; then
        printf "  │  GPU:    %-31s│\n" "AMD Discrete"
    else
        printf "  │  GPU:    %-31s│\n" "Integrated only"
    fi
    printf "  │  Score:  %-31s│\n" "$CPU_SCORE"
    echo "  └─────────────────────────────────────────┘"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
#  MODEL SELECTION
# ═══════════════════════════════════════════════════════════════════════════

# Model tiers:
#   LOW:  qwen2:1.5b  — 934MB disk, ~1.2GB RAM, fast on any CPU
#   MID:  qwen2:7b    — 4.4GB disk, ~5GB RAM, good quality
#   HIGH: mistral     — 4.1GB disk, ~5GB RAM, best quality (needs fast CPU/GPU)

MODEL_LOW="qwen2:1.5b"
MODEL_MID="qwen2:7b"
MODEL_HIGH="mistral"

select_model() {
    # Force flags override detection
    case "${1:-}" in
        --force-low)  SELECTED_MODEL="$MODEL_LOW";  TIER="low (forced)";  return ;;
        --force-mid)  SELECTED_MODEL="$MODEL_MID";  TIER="mid (forced)";  return ;;
        --force-high) SELECTED_MODEL="$MODEL_HIGH"; TIER="high (forced)"; return ;;
        --force-external) SELECTED_MODEL="none"; TIER="external (forced)"; return ;;
    esac

    # Decision tree:
    # 0. RAM < 16GB? → SKIP local LLM entirely, use external API
    #    This prevents memory pressure that causes compositor/mouse lag
    if [ "$RAM_MB" -lt 16000 ]; then
        SELECTED_MODEL="none"
        TIER="external (RAM < 16GB — local LLM would cause lag)"
        warn "RAM < 16GB — skipping local LLM. CIOS will use Intelligence API."
        warn "Pattern matching (80%+ of intents) still works offline."
        return
    fi

    # 1. Not enough disk? → LOW
    if [ "$DISK_FREE_GB" -lt 3 ]; then
        SELECTED_MODEL="$MODEL_LOW"
        TIER="low (disk < 3GB)"
        return
    fi

    # 2. High-end: >8 cores, >12GB RAM, high CPU score or GPU
    if [ "$CPU_CORES" -ge 8 ] && [ "$RAM_MB" -ge 12000 ] && { [ "$CPU_SCORE" -ge 40 ] || [ $HAS_CUDA -eq 1 ]; }; then
        SELECTED_MODEL="$MODEL_HIGH"
        TIER="high"
        return
    fi

    # 3. Mid-range: ≥4 cores, ≥7GB RAM, decent CPU
    if [ "$CPU_CORES" -ge 4 ] && [ "$RAM_MB" -ge 7000 ] && [ "$CPU_SCORE" -ge 20 ] && [ "$DISK_FREE_GB" -ge 5 ]; then
        SELECTED_MODEL="$MODEL_MID"
        TIER="mid"
        return
    fi

    # 4. Everything else → LOW (safe default)
    SELECTED_MODEL="$MODEL_LOW"
    TIER="low"
}

# ═══════════════════════════════════════════════════════════════════════════
#  OLLAMA MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════

ensure_ollama_installed() {
    if command -v ollama &>/dev/null; then
        ok "Ollama already installed"
        return 0
    fi

    info "Installing Ollama..."
    if curl -fsSL https://ollama.com/install.sh | sh; then
        ok "Ollama installed"
    else
        fail "Failed to install Ollama"
        echo "  Install manually: curl -fsSL https://ollama.com/install.sh | sh"
        exit 1
    fi
}

ensure_ollama_running() {
    if curl -sf http://localhost:11434/api/tags &>/dev/null; then
        return 0
    fi

    info "Starting Ollama..."
    systemctl start ollama 2>/dev/null || (ollama serve &>/dev/null & sleep 3)

    # Wait up to 15s
    for i in $(seq 1 30); do
        sleep 0.5
        curl -sf http://localhost:11434/api/tags &>/dev/null && return 0
    done

    fail "Ollama failed to start"
    exit 1
}

pull_model() {
    local model="$1"

    # Check if already available
    if ollama list 2>/dev/null | grep -q "^${model}"; then
        ok "Model '$model' already available"
        return 0
    fi

    info "Downloading model '$model'..."
    if ollama pull "$model"; then
        ok "Model '$model' ready"
    else
        fail "Failed to download '$model'"
        exit 1
    fi
}

remove_old_models() {
    local keep="$1"
    local models_to_remove=("$MODEL_LOW" "$MODEL_MID" "$MODEL_HIGH")

    for model in "${models_to_remove[@]}"; do
        if [ "$model" != "$keep" ]; then
            if ollama list 2>/dev/null | grep -q "^${model}"; then
                info "Removing old model '$model' to free disk space..."
                ollama rm "$model" 2>/dev/null || true
            fi
        fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════
#  CIOS SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

update_cios_settings() {
    local model="$1"

    # Find the CIOS user (first non-root user with UID >= 1000)
    local cios_user
    cios_user=$(awk -F: '$3 >= 1000 && $3 < 65000 {print $1; exit}' /etc/passwd)

    if [ -z "$cios_user" ]; then
        warn "No regular user found, skipping settings update"
        return
    fi

    local home_dir
    home_dir=$(eval echo "~$cios_user")
    local settings_dir="$home_dir/.cios"
    local settings_file="$settings_dir/settings.json"

    mkdir -p "$settings_dir"

    # Merge with existing settings (if any)
    if [ -f "$settings_file" ]; then
        # Update ollama_model in existing settings
        if command -v python3 &>/dev/null; then
            python3 -c "
import json, sys
try:
    with open('$settings_file') as f:
        s = json.load(f)
except:
    s = {}
s['ollama_model'] = '$model'
with open('$settings_file', 'w') as f:
    json.dump(s, f, indent=2)
" 2>/dev/null || echo "{\"ollama_model\": \"$model\"}" > "$settings_file"
        else
            echo "{\"ollama_model\": \"$model\"}" > "$settings_file"
        fi
    else
        echo "{\"ollama_model\": \"$model\"}" > "$settings_file"
    fi

    chown -R "$cios_user:$cios_user" "$settings_dir"
    chmod 600 "$settings_file"

    ok "CIOS configured to use '$model' (user: $cios_user)"
}

# ═══════════════════════════════════════════════════════════════════════════
#  STATUS
# ═══════════════════════════════════════════════════════════════════════════

show_status() {
    detect_hardware
    print_hardware

    echo "  Ollama:"
    if command -v ollama &>/dev/null; then
        echo "    Installed: yes"
        if curl -sf http://localhost:11434/api/tags &>/dev/null; then
            echo "    Running:   yes"
            echo "    Models:"
            ollama list 2>/dev/null | sed 's/^/      /'
        else
            echo "    Running:   no"
        fi
    else
        echo "    Installed: no"
    fi
    echo ""

    select_model
    echo "  Recommended model: $SELECTED_MODEL (tier: $TIER)"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════════════

main() {
    # Handle --status
    if [ "${1:-}" = "--status" ]; then
        show_status
        exit 0
    fi

    echo ""
    echo "╔═══════════════════════════════════════════╗"
    echo "║  CIOS — AI Setup                         ║"
    echo "╚═══════════════════════════════════════════╝"

    # 1. Detect hardware
    info "Detecting hardware..."
    detect_hardware
    print_hardware

    # 2. Select model
    select_model "${1:-}"
    info "Selected model: $SELECTED_MODEL (tier: $TIER)"
    echo ""

    # 3-7: Skip Ollama entirely if external mode (RAM < 16GB)
    if [ "$SELECTED_MODEL" = "none" ]; then
        ok "External mode — no local model needed"
        update_cios_settings "none"
        echo ""
        echo "═══════════════════════════════════════════"
        echo "  ✓ AI backend ready (external mode)"
        echo ""
        echo "  Pattern matching (80%+ of intents) works offline."
        echo "  LLM queries will use CIOS Intelligence API."
        echo "  Connect to Intelligence for full functionality."
        echo "═══════════════════════════════════════════"
        echo ""
        return 0
    fi

    # 3. Ensure Ollama
    ensure_ollama_installed
    ensure_ollama_running

    # 4. Pull model
    pull_model "$SELECTED_MODEL"

    # 5. Remove old models (free disk)
    remove_old_models "$SELECTED_MODEL"

    # 6. Update CIOS settings
    update_cios_settings "$SELECTED_MODEL"

    # 7. Warm up model (load into RAM)
    info "Warming up model (first load)..."
    curl -sf --max-time 60 -X POST http://localhost:11434/api/generate \
        -d "{\"model\":\"$SELECTED_MODEL\",\"prompt\":\"ok\",\"stream\":false,\"options\":{\"num_predict\":1}}" \
        &>/dev/null && ok "Model loaded into RAM" || warn "Warm-up timed out (will load on first use)"

    echo ""
    echo "═══════════════════════════════════════════"
    echo "  ✓ AI backend ready"
    echo ""
    echo "  Model:  $SELECTED_MODEL"
    echo "  Tier:   $TIER"
    echo "  RAM:    ~$([ "$SELECTED_MODEL" = "$MODEL_LOW" ] && echo "1.2GB" || echo "5GB") when active"
    echo ""
    echo "  The model unloads from RAM after 5min idle."
    echo "═══════════════════════════════════════════"
    echo ""
}

main "$@"
